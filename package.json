{
  "name": "dotfiles",
  "type": "module",
  "private": true,
  "scripts": {
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@exbotanical/eslint-config": "1.1.2",
    "@exbotanical/prettier-config": "^1.0.1",
    "eslint": "^9.39.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-ini": "^1.3.0"
  },
  "lint-staged": {
    "*": [
      "prettier --check --ignore-unknown",
      "eslint --no-warn-ignored --max-warnings 0"
    ]
  }
}
