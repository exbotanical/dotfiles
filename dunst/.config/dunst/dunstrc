[global]
    ### Display ###
    monitor = 0
    follow = mouse

    ### Geometry ###
    width = 340
    height = 120
    origin = top-right
    offset = 20x60
    scale = 0
    notification_limit = 8

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    progress_bar_min_width = 200
    progress_bar_max_width = 340

    ### Visual Enhancements ###
    indicate_hidden = yes
    # Matches the 0.95 window opacity in alacritty/.config/alacritty/alacritty.toml.
    transparency = 5
    separator_height = 0
    # Stacked notifications render as separate cards instead of one block with separators.
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12

    corner_radius = 12

    frame_width = 1

    sort = yes
    idle_threshold = 120

    ### Typography ###
    font = "FiraCode Nerd Font 12"
    line_height = 2
    markup = full

    format = "<b>%s</b>\n<span alpha='70%%'>%b</span>"

    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 40
    icon_corner_radius = 6
    # Looks icons up by name in these themes (x11/.config/theme.env installs Dracula), instead of
    # the fixed icon_path directories, which neither machine has. Dracula inherits the status
    # icons (volume, brightness, battery) from Papirus-Dark, which the bootstrap package lists install.
    enable_recursive_icon_lookup = true
    icon_theme = "Dracula, Adwaita"

    ### History ###
    sticky_history = yes
    history_length = 25

    ### Misc/Advanced ###
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/brave -new-tab
    always_run_script = true
    title = "Dunst"
    class = "Dunst"
    ignore_dbusclose = false

    ### Wayland ###
    force_xwayland = false
    force_xinerama = false

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

### Colors from alacritty/.config/alacritty/themes/ghost.toml ###
[urgency_low]
    background = "#282a36"
    foreground = "#bfbfbf"
    frame_color = "#44475a"
    highlight = "#8abeb7"
    timeout = 8

[urgency_normal]
    background = "#282a36"
    foreground = "#f8f8f2"
    frame_color = "#44475a"
    highlight = "#8abeb7"
    timeout = 10

[urgency_critical]
    background = "#282a36"
    foreground = "#f8f8f2"
    frame_color = "#ff5555"
    highlight = "#ff5555"
    timeout = 0
    format = "<b><span foreground='#ff5555'>%s</span></b>\n<span alpha='70%%'>%b</span>"

### Application-Specific Rules ###
[volume]
    appname = "volume"
    set_stack_tag = "volume"
    timeout = 2

[volume_muted]
    appname = "volume"
    summary = "*Muted*"
    set_stack_tag = "volume"
    timeout = 2
    highlight = "#4d4d4d"

[brightness]
    appname = "*brightness*"
    set_stack_tag = "brightness"
    timeout = 2
    # bash/.config/bash/scripts/brightness.bash sends no body, which would render as a blank line.
    format = "<b>%s</b>"

[battery]
    appname = "*battery*"
    set_stack_tag = "battery"

[network]
    appname = "*network*"
    timeout = 6

[music]
    appname = "*music*"
    appname = "*spotify*"
    appname = "*mpd*"
    timeout = 4

[screenshot]
    appname = "Shutter"
    timeout = 3

### Status-Based Frame Accents ###
[success]
    summary = "*success*"
    summary = "*completed*"
    summary = "*done*"
    summary = "*finished*"
    frame_color = "#69ff94"
    timeout = 5

[warning]
    summary = "*warning*"
    summary = "*warn*"
    summary = "*caution*"
    frame_color = "#ffffa5"
    timeout = 8

[error]
    summary = "*error*"
    summary = "*failed*"
    summary = "*fail*"
    summary = "*critical*"
    frame_color = "#ff5555"
    timeout = 12

[info]
    summary = "*info*"
    summary = "*information*"
    summary = "*note*"
    frame_color = "#99d1d8"
    timeout = 6

### Special Rules ###
[transient_disable]
    match_transient = yes
    set_transient = no

[transient_history_ignore]
    match_transient = yes
    history_ignore = yes

[fullscreen_delay_everything]
    fullscreen = show
