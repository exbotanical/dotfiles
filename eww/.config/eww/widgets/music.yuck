(defvar music-reveal false)

; Hovering reveals the playback buttons; the title opens the music window on this bar's monitor.
(defwidget music-widget [screen]
  (eventbox
    :onhover "${EWW_CMD} update music-reveal=true"
    :onhoverlost "${EWW_CMD} update music-reveal=false"
    (box :space-evenly false
      (box :class "song-cover-art" :style "background-image: url(\"${music.cover}\");")
      (button :onclick "${EWW_CMD} open --toggle music --screen ${screen} --arg y=${get_env("EWW_MUSIC_Y")}"
        (label :limit-width 40 :text {music.title}))
      (revealer :transition "slideright" :reveal music-reveal :duration "350ms"
        (box
          (button :onclick "playerctl previous" "")
          (button :onclick "playerctl play-pause" {music.status})
          (button :onclick "playerctl next" ""))))))
