; The connection icon, with the network name on hover, and a VPN shield while a VPN is connected.
(defwidget net-widget []
  (box :space-evenly false
    (button :class "module ${net.class}"
      :onclick "nm-applet > /dev/null 2>&1 &"
      :tooltip "${net.name}: ${net.detail}"
      {net.icon})
    (label :class "module active"
      :visible {net.vpn}
      :tooltip "VPN: ${net.vpn_name}"
      :text {net.vpn_icon})))
