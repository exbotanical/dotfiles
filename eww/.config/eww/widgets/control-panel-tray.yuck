; CPU, RAM, and battery rings; a click opens the control panel on this bar's monitor.
(defwidget control-panel-tray-widget [screen]
  (eventbox :class "module"
    :onclick "${EWW_CMD} open --toggle control-panel-window --screen ${screen} --arg y=${get_env("EWW_CONTROL_PANEL_Y")}"
    (box
      (circular-progress :class "circular-progress cpubar"
        :value {EWW_CPU.avg}
        :thickness {bar_circle_thickness}
        (box :tooltip "using ${round(EWW_CPU.avg, 0)}% cpu"
          (label :class "tray-circle" :text "")))
      (circular-progress :class "circular-progress membar"
        :value {memory.percentage}
        :thickness {bar_circle_thickness}
        (box :tooltip "using ${round(memory.percentage, 0)}% ram"
          (label :class "tray-circle" :text "")))
      (circular-progress :class "circular-progress batbar"
        :value {battery.percentage}
        :style "color: ${battery.color};"
        :thickness {bar_circle_thickness}
        (box :tooltip "battery at ${battery.percentage}% (${battery.status})"
          (label :class "tray-circle" :text ""))))))
