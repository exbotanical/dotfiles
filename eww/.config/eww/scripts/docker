#!/usr/bin/env bash
# Prints the Docker state as one JSON line every INTERVAL seconds: whether the daemon runs, and how
# many containers are running, exited, and created.
# Usage: docker
set -euo pipefail

readonly INTERVAL=5
readonly ICON=''

print_state () {
  if ! systemctl is-active --quiet docker; then
    jq -nc --arg icon "$ICON" '{active: false, running: 0, icon: $icon, class: "disabled", text: "Docker not active"}'
    return
  fi

  local states
  states=$(docker ps -a --format '{{.State}}' 2> /dev/null || true)
  jq -nc --arg icon "$ICON" --arg states "$states" '
    ($states | split("\n") | map(select(. != ""))) as $s
    | ($s | map(select(. == "running")) | length) as $running
    | {
        active: true,
        running: $running,
        icon: $icon,
        class: (if $running > 0 then "active" else "inactive" end),
        text: "\($running) running, \($s | map(select(. == "exited")) | length) stopped, \($s | map(select(. == "created")) | length) created"
      }'
}

while true; do
  print_state
  sleep "$INTERVAL"
done
