#!/usr/bin/env bash
# Prints the night mode state as one JSON line every INTERVAL seconds. Night mode is on when the
# first output's gamma differs from 1.0:1.0:1.0, which covers both the redshift schedule and a
# `night` override.
# Usage: night
set -euo pipefail

readonly INTERVAL=3
readonly NEUTRAL_GAMMA='1.0:1.0:1.0'

# awk reads to the end instead of exiting at the first match: xrandr --verbose prints about 30 KB,
# and an early exit would end xrandr with SIGPIPE.
applied_gamma () {
  xrandr --verbose | awk '/Gamma:/ && !found++ { print $2 }'
}

print_state () {
  if [[ $(applied_gamma) == "$NEUTRAL_GAMMA" ]]; then
    jq -nc '{icon: "󰖙", class: "inactive", text: "Night mode off"}'
  else
    jq -nc '{icon: "󰖔", class: "active", text: "Night mode on"}'
  fi
}

main () {
  if (($# > 0)); then
    printf 'night: unknown command %s\n' "$1" >&2
    exit 1
  fi

  while true; do
    print_state
    sleep "$INTERVAL"
  done
}

main "$@"
