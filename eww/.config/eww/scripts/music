#!/usr/bin/env bash
# Prints the current media track as one JSON line on every playerctl metadata change. Covers given
# as https URLs are downloaded once into COVERS_DIR; the two dominant colors of each new cover
# theme the music window.
# Usage: music
set -euo pipefail

readonly COVERS_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/eww_covers"
readonly SEP=$'\x1f'
readonly FORMAT="{{title}}${SEP}{{artist}}${SEP}{{status}}${SEP}{{position}}${SEP}{{mpris:length}}${SEP}{{mpris:artUrl}}${SEP}{{xesam:url}}"
readonly DEFAULT_COLORS=('#1e1e2e' '#28283d')
# ImageMagick 7 (Arch) deprecates convert in favor of magick; ImageMagick 6 (Ubuntu) has only convert.
if command -v magick > /dev/null; then
  readonly CONVERT=(magick)
else
  readonly CONVERT=(convert)
fi

# Prints microseconds $1 plus $2 seconds as MM:SS below an hour and H:MM:SS from an hour on, or
# nothing when $1 is empty.
track_time () {
  [[ -n $1 ]] || return 0
  local seconds=$(($1 / 1000000 + ${2:-0}))
  if ((seconds >= 3600)); then
    date -u -d@"$seconds" +%-H:%M:%S
  else
    date -u -d@"$seconds" +%M:%S
  fi
}

# Prints the local path of cover $1: a downloaded copy for an https URL, otherwise $1 unchanged.
# YouTube serves WebP covers, which are converted to JPEG for GTK.
cover_path () {
  local url=$1
  [[ $url == https* ]] || {
    printf '%s' "$url"
    return
  }

  local file
  file="$COVERS_DIR/$(basename "$url")"
  if [[ ! -e $file ]]; then
    wget -q -O "$file" "$url" || {
      rm -f "$file"
      return 0
    }
    [[ $(identify -format '%m' "$file" 2> /dev/null) == WEBP ]] && "${CONVERT[@]}" "webp:$file" "jpeg:$file"
  fi
  printf '%s' "$file"
}

# Prints the two dominant colors of image $1, one per line.
cover_colors () {
  "${CONVERT[@]}" "$1" -colors 2 -format '%c' histogram:info: | awk '{ print $3 }'
}

main () {
  mkdir -p "$COVERS_DIR"
  local prev_id='' colors=("${DEFAULT_COLORS[@]}")

  playerctl -F metadata -f "$FORMAT" 2> /dev/null | while IFS="$SEP" read -r title artist status position length cover id; do
    cover=$(cover_path "$cover")
    # Some players emit events without artUrl or url, so colors change only with the track.
    if [[ -n $id && $id != "$prev_id" ]]; then
      if [[ -n $cover ]]; then
        mapfile -t colors < <(cover_colors "$cover")
      else
        colors=("${DEFAULT_COLORS[@]}")
      fi
      prev_id=$id
    fi

    jq -nc \
      --arg title "$title" \
      --arg artist "$artist" \
      --arg playing "$status" \
      --arg position "$position" \
      --arg length "$length" \
      --arg position_time "$(track_time "$position")" \
      --arg length_time "$(track_time "$length" 1)" \
      --arg cover "$cover" \
      --arg color1 "${colors[0]}" \
      --arg color2 "${colors[1]:-${colors[0]}}" '
      {
        title: $title,
        artist: $artist,
        playing: ($playing == "Playing"),
        status: (if $playing == "Playing" then "" else "" end),
        position: (if $position != "" and $length != "" and ($length | tonumber) > 0
                   then ($position | tonumber) / ($length | tonumber) * 100 else 0 end),
        position_time: $position_time,
        length: $length_time,
        cover: $cover,
        color1: $color1,
        color2: $color2
      }'
  done
}

main
