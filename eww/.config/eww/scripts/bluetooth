#!/usr/bin/env bash
# Prints the Bluetooth state as one JSON line every INTERVAL seconds, or toggles Bluetooth.
# Usage: bluetooth
#        bluetooth toggle
set -euo pipefail

readonly INTERVAL=3

print_state () {
  local powered info icon text class battery=''
  powered=$(bluetoothctl show | awk '/Powered:/ { print $2; exit }')
  # With no connected device, bluetoothctl info prints "Missing device address argument".
  info=$(bluetoothctl info 2> /dev/null || true)

  if [[ $powered != yes ]]; then
    icon='󰂲' text='Bluetooth off' class='disabled'
  elif [[ -z $info || $info == 'Missing device address argument'* ]]; then
    icon='󰂯' text='Disconnected' class='inactive'
  else
    icon='󰂰' class='active bt-connected'
    text=$(awk -F': ' '/^[[:space:]]*Name:/ { print $2; exit }' <<< "$info")
    battery=$(sed -n 's/.*Battery Percentage:.*(\([0-9]*\)).*/\1%/p' <<< "$info")
  fi

  jq -nc --arg icon "$icon" --arg text "$text" --arg class "$class" --arg battery "$battery" \
    '{icon: $icon, text: $text, class: $class, battery: $battery}'
}

main () {
  case "${1:-}" in
    toggle)
      rfkill toggle bluetooth
      ;;
    '')
      while true; do
        print_state
        sleep "$INTERVAL"
      done
      ;;
    *)
      printf 'bluetooth: unknown command %s\n' "$1" >&2
      exit 1
      ;;
  esac
}

main "$@"
