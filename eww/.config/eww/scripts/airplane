#!/usr/bin/env bash
# Prints the airplane mode state as one JSON line every INTERVAL seconds, or toggles it. Airplane
# mode is on when every rfkill device is soft-blocked; the first device is a Bluetooth switch on
# both laptops, so blocking Bluetooth alone does not count.
# Usage: airplane
#        airplane toggle
set -euo pipefail

readonly INTERVAL=3

# Prints yes when every radio is soft-blocked, and no otherwise.
soft_blocked () {
  rfkill --noheadings --output SOFT | awk '$1 != "blocked" { on = 1 } END { print (NR > 0 && !on) ? "yes" : "no" }'
}

toggle () {
  if [[ $(soft_blocked) == no ]]; then
    rfkill block all
    notify-send -i airplane-mode-symbolic 'Airplane Mode' 'Airplane mode has been turned on'
  else
    rfkill unblock all
    notify-send -i airplane-mode-disabled-symbolic 'Airplane Mode' 'Airplane mode has been turned off'
  fi
}

print_state () {
  if [[ $(soft_blocked) == no ]]; then
    jq -nc '{icon: "󰀞", class: ""}'
  else
    jq -nc '{icon: "󰀝", class: "airplane-connected"}'
  fi
}

main () {
  case "${1:-}" in
    toggle)
      toggle
      ;;
    '')
      while true; do
        print_state
        sleep "$INTERVAL"
      done
      ;;
    *)
      printf 'airplane: unknown command %s\n' "$1" >&2
      exit 1
      ;;
  esac
}

main "$@"
