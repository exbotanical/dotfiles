#!/usr/bin/env bash
# Prints the audio state as one JSON line at start and on every PulseAudio/PipeWire change, or
# changes the volume of the default sink or source. Every command goes through pactl, which both
# PulseAudio and PipeWire's pipewire-pulse serve.
# Usage: volume
#        volume mute SINK|SOURCE
#        volume set_vol SINK|SOURCE <1-100>
#        volume step SINK|SOURCE up|down
set -euo pipefail

# Volume icons for speakers, lowest level first.
readonly SPEAKER_ICONS=('󰕿' '󰖀' '󰕾')
readonly SPEAKER_MUTED_ICON='󰸈'
readonly HEADPHONES_ICON='󰋋'
readonly HEADPHONES_MUTED_ICON='󰟎'
readonly BLUETOOTH_ICON='󰥰'
readonly MIC_ICON='󰍬'
# The volume change per scroll step.
readonly STEP=0.5%

die () {
  printf 'volume: %s\n' "$*" >&2
  exit 1
}

# Prints the number of streams that record from a microphone. Streams from sink monitors (screen
# recorders capturing desktop audio) and pavucontrol's level meters do not count.
recording_count () {
  jq -n \
    --argjson sources "$(pactl -f json list sources)" \
    --argjson outputs "$(pactl -f json list source-outputs)" '
    ($sources | map(select(.name | endswith(".monitor") | not) | .index)) as $mics
    | $outputs
    | map(select((.source as $s | $mics | index($s)) and .properties["media.name"] != "Peak detect"))
    | length'
}

print_state () {
  pactl -f json list sinks | jq -c \
    --arg sink "$(pactl get-default-sink)" \
    --argjson recording "$(recording_count)" \
    --argjson speaker_icons "$(printf '%s\n' "${SPEAKER_ICONS[@]}" | jq -R . | jq -sc .)" \
    --arg speaker_muted "$SPEAKER_MUTED_ICON" \
    --arg headphones "$HEADPHONES_ICON" \
    --arg headphones_muted "$HEADPHONES_MUTED_ICON" \
    --arg bluetooth "$BLUETOOTH_ICON" \
    --arg mic "$MIC_ICON" '
    (map(select(.name == $sink)) | first) as $s
    | ([$s.volume[].value_percent | rtrimstr("%") | tonumber] | max | if . > 100 then 100 else . end) as $percent
    | (if ($s.name | startswith("bluez_output")) then "bluetooth"
       elif (($s.active_port // "") | test("headphone")) then "headphones"
       else "speakers" end) as $output
    | {
        percent: $percent,
        muted: $s.mute,
        output: $output,
        device: $s.description,
        icon: (if $output == "bluetooth" then $bluetooth
               elif $output == "headphones" then (if $s.mute then $headphones_muted else $headphones end)
               elif $s.mute then $speaker_muted
               else $speaker_icons[[($percent / 34 | floor), 2] | min] end),
        mic_in_use: ($recording > 0),
        mic_icon: $mic
      }'
}

require_device () {
  [[ $1 == SINK || $1 == SOURCE ]] || die "expected SINK or SOURCE, got '$1'"
}

main () {
  case "${1:-}" in
    mute)
      require_device "${2:-}"
      pactl "set-${2,,}-mute" "@DEFAULT_$2@" toggle
      ;;
    set_vol)
      require_device "${2:-}"
      ((${3:-0} >= 1 && ${3:-0} <= 100)) || die 'volume must be between 1 and 100'
      pactl "set-${2,,}-volume" "@DEFAULT_$2@" "$3%"
      ;;
    step)
      require_device "${2:-}"
      case ${3:-} in
        up) pactl "set-${2,,}-volume" "@DEFAULT_$2@" "+$STEP" ;;
        down) pactl "set-${2,,}-volume" "@DEFAULT_$2@" "-$STEP" ;;
        *) die "expected up or down, got '${3:-}'" ;;
      esac
      ;;
    '')
      print_state
      pactl subscribe | grep --line-buffered -E "on (sink|source|source-output|server|card) " | while read -r _; do
        print_state
      done
      ;;
    *)
      die "unknown command '$1'"
      ;;
  esac
}

main "$@"
