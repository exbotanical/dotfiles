#!/usr/bin/env bash
# Prints RAM use as one JSON line every INTERVAL seconds: SI-formatted total and used, and the used
# percentage to one decimal.
# Usage: memory
set -euo pipefail

readonly INTERVAL=3

while true; do
  read -r total used < <(free -b | awk '/^Mem:/ { print $2, $3 }')
  jq -nc \
    --arg total "$(numfmt --to=si --round=towards-zero "$total")" \
    --arg used "$(numfmt --to=si --round=towards-zero "$used")" \
    --argjson percentage "$((used * 1000 / total))" \
    '{total: $total, used: $used, percentage: ($percentage / 10)}'
  sleep "$INTERVAL"
done
