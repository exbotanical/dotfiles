#!/usr/bin/env bash
# Prints, at start and on every i3 workspace or output event, one JSON line that maps each active
# output to the dots of workspaces 1-10 on its bar. A workspace that does not exist or is on another
# output gets the EMPTY color there.
# Usage: workspaces
set -euo pipefail

# The color of workspace N is COLORS[N % 10], so workspace 10 uses the first entry.
readonly COLORS=('#01d9fa' '#f5db69' '#2d9abe' '#2bc7e3' '#a8ff4b' '#19e4e0' '#17dec9' '#14d8b3' '#11d29d' '#0fcc87')
readonly EMPTY='#313244'
readonly FOCUSED='#ffa7f6'

print_workspaces () {
  jq -nc \
    --argjson workspaces "$(i3-msg -t get_workspaces)" \
    --argjson outputs "$(i3-msg -t get_outputs)" \
    --argjson colors "$(printf '%s\n' "${COLORS[@]}" | jq -R . | jq -sc .)" \
    --arg empty "$EMPTY" \
    --arg focused "$FOCUSED" '
    $outputs
    | map(select(.active) | .name as $output | {
        key: $output,
        value: [range(1; 11) as $n
          | ($workspaces | map(select(.num == $n)) | first) as $ws
          | {
              number: $n,
              tooltip: ($ws.name // ""),
              color: (if $ws == null or $ws.output != $output then $empty
                      elif $ws.focused then $focused
                      else $colors[$n % 10] end)
            }]
      })
    | from_entries'
}

print_workspaces
i3-msg -t subscribe -m '["workspace", "output"]' | while read -r _; do
  print_workspaces
done
