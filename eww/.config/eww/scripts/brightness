#!/usr/bin/env bash
# Prints the screen brightness as one JSON line at start and on every backlight udev event.
# Usage: brightness
set -euo pipefail

# Brightness icons, dimmest first.
readonly ICONS=('󰃝' '󰃟' '󰃞')

print_state () {
  local level
  level=$(light)
  jq -nc --argjson level "$level" --argjson icons "$(printf '%s\n' "${ICONS[@]}" | jq -R . | jq -sc .)" \
    '{level: $level, icon: $icons[[($level / 34 | floor), 2] | min]}'
}

print_state
udevadm monitor --subsystem-match=backlight | grep --line-buffered 'backlight' | while read -r _; do
  print_state
done
