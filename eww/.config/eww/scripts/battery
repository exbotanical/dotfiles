#!/usr/bin/env bash
# Prints the state of the first battery as one JSON line every INTERVAL seconds, and sends a
# critical notification every LOW_NOTIFY_INTERVAL seconds while it is not charging and at or below
# LOW_PERCENT. Without a battery, prints one line with percentage 0 and exits.
# Usage: battery
# See: https://www.kernel.org/doc/html/latest/power/power_supply_class.html
set -euo pipefail

readonly INTERVAL=1
readonly LOW_PERCENT=15
readonly LOW_NOTIFY_INTERVAL=30

if [[ ${SYSTEM_THEME:-} == everforest ]]; then
  readonly RED='#e67e80' YELLOW='#dbbc7f' GREEN='#a7c080' BLUE='#7fbbb3'
else
  readonly RED='#ff5555' YELLOW='#f1fa8c' GREEN='#83f59f' BLUE='#8be9fd'
fi

# Prints the time until empty (discharging) or full (charging) as H:MM, or nothing when the
# battery does not report energy and power.
time_left () {
  local dir=$1 state=$2 now full power
  [[ -r $dir/energy_now && -r $dir/energy_full && -r $dir/power_now ]] || return 0
  now=$(< "$dir/energy_now")
  full=$(< "$dir/energy_full")
  power=$(< "$dir/power_now")
  ((power > 0)) || return 0

  local minutes
  if [[ $state == Discharging ]]; then
    minutes=$((now * 60 / power))
  else
    minutes=$(((full - now) * 60 / power))
  fi
  printf '%d:%02d' $((minutes / 60)) $((minutes % 60))
}

# Prints the circle color: alternating blue and green on odd and even ticks while charging,
# otherwise by capacity.
color () {
  local state=$1 capacity=$2 tick=$3
  if [[ $state == Charging ]] && ((tick % 2 == 0)); then
    printf '%s' "$BLUE"
  elif [[ $state == Charging ]]; then
    printf '%s' "$GREEN"
  elif ((capacity <= 20)); then
    printf '%s' "$RED"
  elif ((capacity <= 60)); then
    printf '%s' "$YELLOW"
  else
    printf '%s' "$GREEN"
  fi
}

status () {
  local state=$1 left=$2
  case $state in
    Charging) printf 'charging%s' "${left:+, $left until full}" ;;
    Discharging) printf '%s' "${left:+$left left}" ;;
    *) printf 'full' ;;
  esac
}

main () {
  local dir
  dir=$(compgen -G '/sys/class/power_supply/BAT*' | head -n 1 || true)
  if [[ -z $dir ]]; then
    jq -nc --arg color "$GREEN" '{percentage: 0, color: $color, status: "no battery"}'
    return
  fi

  local tick=0 last_notified=-$LOW_NOTIFY_INTERVAL capacity state
  while true; do
    capacity=$(< "$dir/capacity")
    state=$(< "$dir/status")

    if [[ $state != Charging ]] && ((capacity <= LOW_PERCENT && SECONDS - last_notified >= LOW_NOTIFY_INTERVAL)); then
      notify-send -u critical -a battery 'Battery low' "$capacity% remaining"
      last_notified=$SECONDS
    fi

    jq -nc \
      --argjson percentage "$capacity" \
      --arg color "$(color "$state" "$capacity" "$tick")" \
      --arg status "$(status "$state" "$(time_left "$dir" "$state")")" \
      '{percentage: $percentage, color: $color, status: $status}'

    sleep "$INTERVAL"
    tick=$((tick + 1))
  done
}

main
