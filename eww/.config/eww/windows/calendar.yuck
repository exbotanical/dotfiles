; Clicking a day opens it in Outlook or GNOME Calendar (scripts/open-day).
(defwidget calendar-widget []
  (box :class "calendar-window"
    (calendar
      :onclick "${EWW_CMD} close calendar-window && scripts/open-day {0} {1} {2} &")))

(defwindow calendar-window
  :monitor 0
  :stacking "fg"
  :wm-ignore true
  :geometry (geometry :x "0" :y "43" :width "0px" :height "0px" :anchor "top right")
  (calendar-widget))
