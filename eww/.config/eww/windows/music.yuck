; The window takes its colors from the two dominant colors of the cover.
(defwidget music []
  (box :class "music-window" :space-evenly false
    :style "background-color: ${music.color1}; border: 1px solid ${music.color2};"
    (box :class "music-cover-art" :style "background-image: url(\"${music.cover}\");")
    (box :class "music-box" :orientation "v"
      (label :class "music-title" :wrap true :text {music.title})
      (label :class "music-artist" :wrap true :text {music.artist})
      (centerbox :class "music-button-box" :halign "center"
        (button :class "music-button" :onclick "playerctl previous" "")
        (button :class "music-button" :onclick "playerctl play-pause" {music.status})
        (button :class "music-button" :onclick "playerctl next" ""))
      (box :orientation "v"
        (box
          (label :class "music-time" :xalign 0 :text {music.position_time})
          (label :class "music-time" :xalign 1 :text {music.length}))
        (box :class "music-bar"
          (scale
            :value {music.position}
            :onchange "playerctl position $(awk -v p={} -v l=$(playerctl metadata mpris:length) 'BEGIN { print p * l / 100000000 }')"))))))

(defwindow music [y]
  :monitor 0
  :stacking "fg"
  :focusable false
  :geometry (geometry :x "0" :y y :width "0%" :height "0%" :anchor "top center")
  (music))
