(include "./variables.yuck")
(include "./widgets/bluetooth.yuck")
(include "./widgets/brightness.yuck")
(include "./widgets/clock.yuck")
(include "./widgets/docker.yuck")
(include "./widgets/music.yuck")
(include "./widgets/net.yuck")
(include "./widgets/control-panel-tray.yuck")
(include "./widgets/volume.yuck")
(include "./widgets/workspaces.yuck")

(include "./windows/calendar.yuck")
(include "./windows/control-panel.yuck")
(include "./windows/music.yuck")
; (include "./windows/osd.yuck")

(defwidget left-widget [screen]
  (box
    :space-evenly false
    :halign "start"
    (workspaces-widget :screen screen)))

(defwidget right-widget [screen]
  (box
    :space-evenly false
    :halign "end"
    (brightness-widget)
    (volume-widget)
    (bluetooth-widget)
    (net-widget)
    (docker-widget)
    (control-panel-tray-widget :screen screen)
    (clock-widget :screen screen)
  ))

(defwidget center-widget [screen]
  (box
    :space-evenly false
    :halign "center"
    (music-widget :screen screen)))

(defwidget bar-widget [screen]
  (systray
    :class "bar"
    :space-evenly true
    (left-widget :screen screen)
    (center-widget :screen screen)
    (right-widget :screen screen)))

(defwindow bar [screen]
  :monitor screen
  :windowtype "dock"
  :geometry (geometry :x "0%"
    :y "0%"
    :width "100%"
    :height "30px"
  :anchor "top center")
  :stacking "fg"
  :reserve (struts :distance "30px" :side "top")
  (bar-widget :screen screen))
