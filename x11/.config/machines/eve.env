# Sizes for eve, the Arch desktop. DEFAULT=1 marks the profile that .xprofile and the bootstrap
# use when ~/.config/machine names no profile. Sourced by bash.
DEFAULT=1
GTK_FONT='FiraCode Nerd Font 20'
CURSOR_SIZE=42
X_FONT_SIZE=20
I3_FONT_SIZE=20

# eww popup y offsets in pixels from the top of the monitor; .xprofile exports EWW_* keys.
EWW_MUSIC_Y=24
EWW_CONTROL_PANEL_Y=24
