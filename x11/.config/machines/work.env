# Sizes for work, the Ubuntu laptop. Sourced by bash.
GTK_FONT='Noto Sans 10'
CURSOR_SIZE=24
X_FONT_SIZE=12
# i3 sizes its font by DPI, so 8 at 134 DPI matches 11 at 96.
I3_FONT_SIZE=8

# Xft.dpi and the GTK Xft/DPI setting: 1.4 times 96, for the 142 DPI laptop panel.
X_DPI=134

# eww popup y offsets in pixels from the top of the monitor; .xprofile exports EWW_* keys.
EWW_MUSIC_Y=2
EWW_CONTROL_PANEL_Y=10
