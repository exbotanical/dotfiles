# The GTK, icon, and cursor themes that .xprofile applies and the bootstrap installs. Each theme
# has the directory name the session references, the zip that provides it, and the directory
# inside that zip. Sourced by POSIX sh and bash.
GTK_THEME=Dracula
GTK_THEME_URL=https://github.com/dracula/gtk/archive/master.zip
GTK_THEME_DIR=gtk-master

ICON_THEME=Dracula
ICON_THEME_URL=https://github.com/dracula/gtk/files/5214870/Dracula.zip
ICON_THEME_DIR=Dracula

CURSOR_THEME=catppuccin-frappe-sapphire-cursors
CURSOR_THEME_URL=https://github.com/catppuccin/cursors/releases/download/v2.0.0/catppuccin-frappe-sapphire-cursors.zip
CURSOR_THEME_DIR=catppuccin-frappe-sapphire-cursors

# The colour scheme preference that libadwaita and Chromium-based applications read through the
# desktop portal, which takes it from this GSettings key.
COLOR_SCHEME=prefer-dark
