! Base X11 configuration (non-theme settings)
! These settings are independent of color themes

! Font rendering. Xft.dpi differs per machine; ~/.xprofile merges it.
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb

! The cursor and default font sizes differ per machine; ~/.xprofile merges them.
