# shpec has no shebang, so the recipe shell must be bash for shpec and its tests to run as bash.
SHELL := bash

# Shells read these rc files, which source init.bash. They are generated, read-only regular files
# rather than links into the repo, so an installer that appends to ~/.bashrc or ~/.bash_profile
# fails there instead of writing to init.bash. rm runs first because the files are read-only.
RC_FILES := $(HOME)/.bashrc $(HOME)/.bash_profile

.PHONY: all postinstall unit_test

all:

postinstall:
	@for rc in $(RC_FILES); do \
		rm -f "$$rc"; \
		printf '%s\n' '# Generated by bash/Makefile. Edit ~/.config/bash/init.bash instead.' \
			'source "$$HOME/.config/bash/init.bash"' > "$$rc"; \
		chmod 444 "$$rc"; \
	done

unit_test:
	shpec tests/*_shpec.bash
