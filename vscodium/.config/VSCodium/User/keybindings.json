[
  {
    "key": "alt+right",
    "command": "cursorLineEnd",
    "when": "isLinux"
  },
  {
    "key": "shift+alt+right",
    "command": "cursorLineEndSelect",
    "when": "isLinux"
  },
  {
    "key": "alt+left",
    "command": "cursorLineStart",
    "when": "isLinux"
  },
  {
    "key": "shift+alt+left",
    "command": "cursorLineStartSelect",
    "when": "isLinux"
  },
  {
    "key": "alt+left",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "isLinux && terminalFocus && terminalHasBeenCreated && !terminalEditorFocus"
  },
  {
    "key": "alt+right",
    "command": "workbench.action.terminal.focusNext",
    "when": "isLinux && terminalFocus && terminalHasBeenCreated && !terminalEditorFocus"
  },
  {
    "key": "ctrl+b",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "isLinux && editorTextFocus"
  },
  {
    "key": "ctrl+shift+d",
    "command": "dockerContainers.focus",
    "when": "isLinux"
  },
  {
    "key": "ctrl+shift+f",
    "command": "vue3snippets.format",
    "when": "isLinux && editorTextFocus && !editorReadonly && editorLangId == 'vue'"
  },
  {
    "key": "ctrl+cmd+left",
    "command": "cursorWordEndLeft"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditor"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.previousEditor"
  },
  {
    "key": "ctrl+shift+m",
    "command": "workbench.action.toggleMaximizedPanel"
  },
  {
    "key": "ctrl+shift+r",
    "command": "workbench.files.action.collapseExplorerFolders"
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+shift+v",
    "command": "markdown.extension.closePreview",
    "when": "!terminalFocus && activeWebviewPanelId == 'markdown.preview'"
  },
  {
    "key": "ctrl+shift+v",
    "command": "-markdown.extension.closePreview",
    "when": "activeWebviewPanelId == 'markdown.preview'"
  }
]
