# The kernel creates /sys/class/backlight/*/brightness as root:root 0644, so
# brightnessctl run by a user fails with "Permission denied". Arch's
# brightnessctl sets the level through systemd-logind; Ubuntu's 0.5.1-3.1 is
# built without logind support and ships no udev rule. These rules, taken from
# upstream brightnessctl's 90-brightnessctl.rules, give the video group write
# access to each backlight device when it is added.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
